// Prisma schema for the TextIQ app.
// The datasource URL is supplied via prisma.config.ts (env DATABASE_URL).
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String?
  image                String?
  passwordHash         String?
  // Bumped when credentials rotate so JWT sessions issued before the stamp are
  // rejected by Node-runtime session validation.
  sessionInvalidatedAt DateTime?
  // Email verification (#162): null until the user confirms ownership of their
  // address via a verification link; stamped with the confirmation time.
  emailVerified        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  // Monetization: tier + credit balance
  plan                 String    @default("free")
  creditBalance        Int       @default(0)
  creditPeriodStart    DateTime?
  // Onboarding: once dismissed (or completed), the checklist is never shown again
  onboardingDismissed  Boolean   @default(false)

  documents                      Document[]               @relation("DocumentOwner")
  ownedWorkspaces                Workspace[]              @relation("WorkspaceOwner")
  memberships                    WorkspaceMember[]
  comments                       Comment[]
  tags                           Tag[]
  brands                         Brand[]                  @relation("BrandOwner")
  brandKitDrafts                 BrandKitDraft[]          @relation("BrandKitDraftOwner")
  themePackageSnapshots          ThemePackageSnapshot[]   @relation("ThemePackageSnapshotOwner")
  publishedThemePackageSnapshots ThemePackageSnapshot[]   @relation("ThemePackageSnapshotPublisher")
  subscription                   Subscription?
  passwordResetTokens            PasswordResetToken[]
  emailVerificationTokens        EmailVerificationToken[]
  documentVersions               DocumentVersion[]
  commentReads                   CommentRead[]
}

// A single-use, time-boxed credential for confirming a user owns their email
// address (#162). Mirrors PasswordResetToken: only a HASH of the emailed token
// is stored (`tokenHash`), never the raw token, so a database leak cannot be
// replayed. A token is valid only while `usedAt` is null and `now < expiresAt`;
// completing verification stamps `usedAt` (and the user's `emailVerified`) and
// invalidates the user's other outstanding verification tokens.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A single-use, time-boxed credential for the self-serve password reset flow
// (#140). Only a HASH of the emailed token is stored (`tokenHash`), never the
// raw token, so a database leak cannot be replayed to reset an account. A token
// is valid only while `usedAt` is null and `now < expiresAt`; completing a reset
// stamps `usedAt` and invalidates the user's other outstanding tokens.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner                 User                   @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members               WorkspaceMember[]
  documents             Document[]
  assets                Asset[]
  inviteLinks           InviteLink[]
  brandKitDrafts        BrandKitDraft[]
  themePackageSnapshots ThemePackageSnapshot[]

  @@index([ownerId])
}

model BrandKitDraft {
  id                   String   @id @default(cuid())
  slug                 String
  name                 String
  ownerId              String
  workspaceId          String?
  scope                String
  scopeKey             String
  sourcePresetId       String?
  version              String
  revisionId           String
  revisionNumber       Int
  draftJson            Json
  latestPackageId      String?
  latestPackageVersion String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  owner     User                   @relation("BrandKitDraftOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  workspace Workspace?             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshots ThemePackageSnapshot[]

  @@unique([scopeKey, slug])
  @@index([ownerId])
  @@index([workspaceId])
  @@index([latestPackageId, latestPackageVersion])
}

model ThemePackageSnapshot {
  id             String   @id @default(cuid())
  packageId      String
  packageVersion String
  draftId        String?
  ownerId        String
  workspaceId    String?
  publishedById  String?
  packageJson    Json
  createdAt      DateTime @default(now())

  draft       BrandKitDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)
  owner       User           @relation("ThemePackageSnapshotOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  workspace   Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  publishedBy User?          @relation("ThemePackageSnapshotPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([packageId, packageVersion])
  @@index([packageId])
  @@index([ownerId])
  @@index([workspaceId])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("VIEWER")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Document {
  id                  String    @id @default(cuid())
  title               String    @default("Untitled")
  content             String    @default("")
  contentJson         Json?
  deckJson            Json?
  deckRevisionToken   String?
  ownerId             String
  workspaceId         String?
  shareId             String?   @unique
  slug                String?   @unique
  isShared            Boolean   @default(false)
  // Share-link lifecycle & access policy (issue #101).
  shareExpiresAt      DateTime?
  shareEmbedEnabled   Boolean   @default(true)
  sharePresentEnabled Boolean   @default(true)
  sharePasscodeHash   String?
  // Public metadata privacy controls (Epic N15): links default to generic,
  // non-discoverable unfurls unless the owner explicitly opts in.
  shareMetadataMode   String    @default("generic")
  shareDiscoverable   Boolean   @default(false)
  favorite            Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  // Best-effort collaboration recovery snapshot (#497). When a dirty collab
  // room is evicted, the server flushes the room's Yjs update (base64) here so
  // edits that never reached the canonical `contentJson` autosave are not
  // silently lost. This is NOT the source of truth — `contentJson` remains
  // canonical; the snapshot is a recovery aid only and is never read on the
  // normal load path.
  collabRecoverySnapshot String?
  collabRecoverySavedAt  DateTime?
  owner                  User              @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  workspace              Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  visuals                Visual[]
  comments               Comment[]
  tags                   Tag[]             @relation("DocumentTags")
  versions               DocumentVersion[]
  commentReads           CommentRead[]
  assets                 Asset[]

  @@index([ownerId])
  @@index([workspaceId])
  @@index([shareId])
  @@index([deletedAt])
}

// Flat, owner-scoped tags for organizing documents. Tag names (and slugs) are
// unique per owner; the many-to-many relation to Document uses an implicit
// join table (`_DocumentTags`). The slug derives from slugify(name) (US-027).
model Tag {
  id        String   @id @default(cuid())
  name      String
  slug      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  documents Document[] @relation("DocumentTags")

  @@unique([ownerId, name])
  @@unique([ownerId, slug])
  @@index([ownerId])
}

model Visual {
  id            String   @id @default(cuid())
  documentId    String
  anchorBlockId String?
  orderIndex    Int      @default(0)
  type          String
  title         String?
  data          Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  document  Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revisions VisualRevision[]

  @@unique([documentId, anchorBlockId])
  @@index([documentId])
}

model VisualRevision {
  id        String   @id @default(cuid())
  visualId  String
  data      Json
  type      String
  title     String?
  createdAt DateTime @default(now())

  visual Visual @relation(fields: [visualId], references: [id], onDelete: Cascade)

  @@index([visualId])
}

// Point-in-time snapshot of a document's editable state (issue #158). Saves
// overwrite Document.contentJson/deckJson in place, so these rows preserve
// earlier versions for viewing and restore. Captured under the edit-permission
// path, throttled by time and pruned to the most recent N per document.
model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  contentJson Json
  deckJson    Json?
  label       String?
  createdById String?
  createdAt   DateTime @default(now())

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([createdById])
}

model Comment {
  id             String   @id @default(cuid())
  documentId     String
  authorId       String
  body           String
  resolved       Boolean  @default(false)
  parentId       String?
  // Optional anchor tying a top-level comment to text or a visual element.
  // anchorType: null (whole document) | "text" | "visual" | "table".
  anchorType     String?
  anchorText     String?
  anchorNodeId   String?
  // Slide-level anchor fields (Epic #380). All nullable so existing comments
  // are unaffected. slideId references a Slide.id in the deckJson. elementId
  // references a SlideElement.id within that slide. anchorGeometry holds an
  // optional {x,y} point in percent units (0-100) for pin placement.
  slideId        String?
  elementId      String?
  anchorGeometry Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  document Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  @@index([documentId])
  @@index([authorId])
  @@index([parentId])
  @@index([slideId])
}

// Per-user read state for a document's comment thread (issue #160). One row per
// (user, document): `lastReadAt` is stamped to now() whenever the user opens the
// comments panel. The unread count for a user is the number of comments on the
// document created after `lastReadAt` (or all of them when no row exists yet),
// excluding the user's own comments. This powers the in-app unread indicator on
// the comments entry point. Only members with view access read/write a row.
model CommentRead {
  id         String   @id @default(cuid())
  userId     String
  documentId String
  lastReadAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
  @@index([documentId])
}

model InviteLink {
  id          String    @id @default(cuid())
  workspaceId String
  token       String    @unique
  role        String    @default("VIEWER")
  isRevoked   Boolean   @default(false)
  // Hardening (issue #103): optional expiry and usage cap. `expiresAt` null =
  // never expires; `maxUses` null = unlimited uses; `useCount` tracks accepted
  // joins so a capped link can be denied once exhausted.
  expiresAt   DateTime?
  maxUses     Int?
  useCount    Int       @default(0)
  createdById String
  createdAt   DateTime  @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uses      InviteLinkUse[]

  @@index([workspaceId])
  @@index([token])
}

// Per-join audit trail for workspace invite links (issue #103). One row is
// written for every successful join, capturing who joined, with which role,
// and when — so usage can be reviewed and `InviteLink.useCount` reconciled.
model InviteLinkUse {
  id           String   @id @default(cuid())
  inviteLinkId String
  userId       String
  role         String
  usedAt       DateTime @default(now())

  inviteLink InviteLink @relation(fields: [inviteLinkId], references: [id], onDelete: Cascade)

  @@index([inviteLinkId])
  @@index([userId])
}

// Shared, DB-backed fixed-window rate-limit state for the AI generation
// endpoint (US-018). One row per subject (an authenticated user id); the row
// holds the current window's hit count and its reset instant. Persisting this
// instead of a per-instance in-memory Map lets the limit hold across instances
// in production. The window is first-request-anchored (resetAt = first hit +
// window), preserving the existing in-memory semantics.
model RateLimitHit {
  subject   String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

// A saved brand style owned by one user (US-007 — Brand Studio).
// All color fields are optional so a brand can hold a partial palette
// and defaults fall through to the visual DEFAULT_STYLE. `fontFamily`
// overrides the visual's font when the brand is applied.
model Brand {
  id          String   @id @default(cuid())
  name        String
  ownerId     String
  // Color fields (all optional — null means "keep visual default")
  palette     Json?
  background  String?
  nodeFill    String?
  nodeStroke  String?
  nodeText    String?
  edgeColor   String?
  // Typography
  fontFamily  String?
  // Brand media is stored as protected `Asset` rows (served via
  // /api/brand-assets/…), not as raw data URLs. `logoAssetId` and `fontAssetId`
  // point at the owning brand's logo/font asset. Display URLs are derived from
  // the referenced asset's `storageKey` at read time and are never persisted.
  logoAssetId String?
  fontAssetId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner  User    @relation("BrandOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  // Assets scoped to this brand (logo, font, future media). Cleared to null on
  // brand delete (onDelete: SetNull on Asset.brandId) so a cleanup pass can
  // orphan + purge them rather than leaving permanent orphans.
  assets Asset[] @relation("BrandAssets")

  @@index([ownerId])
  @@index([logoAssetId])
  @@index([fontAssetId])
}

// Monetization: active subscription for a user.
// One row per user — upserted on plan changes. Stores the billing period,
// the Stripe customer and subscription ids (kept separate — a customer can
// outlive any single subscription), and cancellation intent.
model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  plan                 String   @default("free")
  status               String   @default("active")
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Idempotency ledger for processed Stripe webhook events.
// One row per Stripe `event.id`. The handler records the id before applying
// an event and short-circuits when the id already exists, so retries and
// out-of-order redeliveries are no-ops instead of double-applying state.
model StripeWebhookEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

// Durable asset record for slide images, background media, and future media
// types (Epic #374). Each upload is tracked by its storage key so that
// multiple slide elements can reference the same bytes without duplication.
// Soft-delete via `deletedAt` preserves the row for version-restore safety;
// a background cleanup job can permanently remove rows where deletedAt is set
// and no slide element references the asset.
model Asset {
  id           String    @id @default(cuid())
  // Scope: an asset may be owned by a document, workspace, or brand.
  documentId   String?
  workspaceId  String?
  // Brand scope (Epic #496): set when the asset backs a brand logo/font. On
  // brand delete this is set to null so the orphan/purge pass can reclaim it.
  brandId      String?
  mimeType     String
  byteSize     Int
  // Pixel dimensions — null for non-image types (e.g., video, font).
  widthPx      Int?
  heightPx     Int?
  // SHA-256 hex digest of the raw file bytes — used for dedup and integrity.
  checksum     String
  // Opaque storage path / object key (e.g., S3 key or local path).
  storageKey   String    @unique
  // Optional pre-generated thumbnail object key.
  thumbnailKey String?
  // Original client-provided filename for display/download UX.
  originalName String?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  document  Document?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  brand     Brand?     @relation("BrandAssets", fields: [brandId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([workspaceId])
  @@index([brandId])
  @@index([checksum])
}

// ---------------------------------------------------------------------------
// Usage ledger (Epic #478, issue #481)
// ---------------------------------------------------------------------------

/**
 * Durable ledger entry for AI generation credit usage.
 * Lifecycle: reserved → captured (on success) or refunded (on failure).
 * Idempotent by `idempotencyKey`: callers must supply a stable per-request
 * key (e.g. a request UUID) so retries never double-charge.
 * Status values:
 * "reserved"  — intent recorded; credits NOT yet deducted.
 * "captured"  — generation succeeded; credits atomically deducted.
 * "refunded"  — generation failed; entry tombstoned; credits unchanged.
 */
model UsageLedgerEntry {
  id             String    @id @default(cuid())
  /// Stable per-request key — prevents double-charge on retry.
  idempotencyKey String    @unique
  userId         String
  /// Logical operation name, e.g. "generate" or "generate-deck".
  operation      String
  creditCost     Int
  /// One of: "reserved" | "captured" | "refunded"
  status         String    @default("reserved")
  reservedAt     DateTime  @default(now())
  capturedAt     DateTime?
  refundedAt     DateTime?

  @@index([userId])
  @@index([status])
}
